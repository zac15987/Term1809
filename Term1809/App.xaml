<Application x:Class="Term1809.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Term1809"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDark.xaml" />
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Windows-Terminal-style title bar / tab palette (defined app-level so the
                 MainWindow root element can reference them via StaticResource) -->
            <SolidColorBrush x:Key="TitleBarBrush" Color="#FF202020"/>
            <SolidColorBrush x:Key="TabHoverBrush" Color="#FF2D2D2D"/>
            <SolidColorBrush x:Key="TabCloseHoverBrush" Color="#FF4D4D4D"/>
            <SolidColorBrush x:Key="TabActiveBrush" Color="#FF0C0C0C"/>
            <SolidColorBrush x:Key="TabForegroundBrush" Color="#FFAFAFAF"/>
            <SolidColorBrush x:Key="TabActiveForegroundBrush" Color="#FFF2F2F2"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
